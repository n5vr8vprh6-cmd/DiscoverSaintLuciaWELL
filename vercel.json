{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node build.js",
  "outputDirectory": "dist",
  "framework": null,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/foundations",
      "destination": "/advisors/foundations",
      "permanent": true
    },
    {
      "source": "/advisors/hub/:rest+",
      "destination": "/hub/:rest+",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": ".*\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "functions": {
    "api/hub/index.js": {
      "includeFiles": "{css,js}/**",
      "maxDuration": 60
    },
      "api/gtm.js": {
      "includeFiles": "{css,js}/**",
      "maxDuration": 60
    },
    "api/**/*.js": {
      "includeFiles": "{css,js}/**"
    }
  },
  "rewrites": [
    {
      "source": "/hub",
      "destination": "/api/hub?screen=home"
    },
    {
      "source": "/hub/login",
      "destination": "/api/hub?screen=login"
    },
    {
      "source": "/hub/register",
      "destination": "/api/hub?screen=register"
    },
    {
      "source": "/hub/forgot",
      "destination": "/api/hub?screen=forgot"
    },
    {
      "source": "/hub/reset",
      "destination": "/api/hub?screen=reset"
    },
    {
      "source": "/hub/account",
      "destination": "/api/hub?screen=account"
    },
    {
      "source": "/hub/journeys",
      "destination": "/api/hub?screen=journeys"
    },
    {
      "source": "/hub/journeys/:id/introduce",
      "destination": "/api/hub?screen=introduce&id=:id"
    },
    {
      "source": "/hub/journeys/:id/design",
      "destination": "/api/hub?screen=design&id=:id"
    },
    {
      "source": "/hub/journeys/:id",
      "destination": "/api/hub?screen=journey&id=:id"
    },
    {
      "source": "/hub/campaign/profile",
      "destination": "/api/hub?screen=campaignProfile"
    },
    {
      "source": "/hub/campaign/more",
      "destination": "/api/hub?screen=campaignMore"
    },
    {
      "source": "/hub/campaign",
      "destination": "/api/hub?screen=campaign"
    },
    {
      "source": "/hub/sweepstakes",
      "destination": "/api/hub?screen=sweepstakes"
    },
    {
      "source": "/hub/sweepstakes/:id",
      "destination": "/api/hub?screen=sweepstakesDetail&id=:id"
    },
    {
      "source": "/hub/undertaking",
      "destination": "/api/hub?screen=undertaking"
    },
    {
      "source": "/hub/admin",
      "destination": "/api/hub?screen=admin"
    },
    {
      "source": "/hub/admin/advisors",
      "destination": "/api/hub?screen=adminAdvisors"
    },
    {
      "source": "/hub/admin/advisors/new",
      "destination": "/api/hub?screen=adminNew"
    },
    {
      "source": "/hub/admin/advisors/:id",
      "destination": "/api/hub?screen=adminAdvisor&id=:id"
    },
    {
      "source": "/hub/admin/import",
      "destination": "/api/hub?screen=adminImport"
    },
    {
      "source": "/hub/admin/audit",
      "destination": "/api/hub?screen=adminAudit"
    },
    {
      "source": "/hub/admin/subject",
      "destination": "/api/hub?screen=adminSubject"
    },
    {
      "source": "/hub/viewas/exit",
      "destination": "/api/hub?screen=viewasExit"
    },
    {
      "source": "/advisors/immersion/waitlist",
      "destination": "/api/hub?screen=waitlist"
    },
    {
      "source": "/j/:token",
      "destination": "/api/hub?screen=itinerary&t=:token"
    },
    {
      "source": "/hub/admin/waitlist",
      "destination": "/api/hub?screen=adminWaitlist"
    },
    {
      "source": "/well/:code",
      "destination": "/api/well?code=:code"
    },
    {
      "source": "/well/:code/:sweeps",
      "destination": "/api/well?code=:code&sweeps=:sweeps"
    },
    {
      "source": "/hub/:rest*",
      "destination": "/api/hub?screen=notFound&path=:rest*"
    }
  ]
}
