# Advisor Hub Phase 1 — set these in Vercel, never in the repo.
# See db/SETUP.md. Everything degrades quietly when they are absent.

# Supabase. The SERVICE ROLE key bypasses row-level security and is
# server-only — build.js copies js/ verbatim into dist/, so anything in
# client code is public.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# New in V2. Supabase Auth exchanges credentials for a session with this key.
# Project Settings -> API -> anon / public.
SUPABASE_ANON_KEY=

# Used to build absolute links in verification and reset emails.
SITE_ORIGIN=https://discoversaintluciawell.com

# Resend. NOTIFY_FROM must be on a domain verified in Resend, or advisor
# notifications land in spam.
RESEND_API_KEY=
NOTIFY_FROM=

# Any long random string. Used to hash IP addresses for rate limiting so we
# never store an address. Absent = rate limiting skipped, never a weak hash.
IP_HASH_SALT=

# Encharge — advisor onboarding sequences (optional).
# Account → Info → the Ingest API write key.
# Without it api/_lib/encharge.js no-ops and nothing else changes: the Hub,
# registration and Journey notifications all behave exactly as they do now.
# Journey notifications deliberately stay on Resend, so an advisor who
# unsubscribes from onboarding email is still told when a client is waiting.
ENCHARGE_TOKEN=

# ── Campaign generation (optional) ──────────────────────────────────────────
# platform.openai.com/api-keys — a PROJECT key, starting sk-proj-.
#
# This is the API, which is billed separately from a ChatGPT subscription. A
# Plus or Pro plan does NOT include API credit; the account needs its own
# balance under Billing, and it is worth setting a monthly limit there before
# the key is ever used.
#
# Without it everything in My Campaign still works — intake, fact bank, claims
# checker, the copy-paste prompt. Only the generated 30-day plan needs it.
OPENAI_API_KEY=
