# Advisor Hub Phase 1 — set these in Vercel, never in the repo.
# See db/SETUP.md. Everything degrades quietly when they are absent.

# Supabase. The SERVICE ROLE key bypasses row-level security and is
# server-only — build.js copies js/ verbatim into dist/, so anything in
# client code is public.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend. NOTIFY_FROM must be on a domain verified in Resend, or advisor
# notifications land in spam.
RESEND_API_KEY=
NOTIFY_FROM=

# Any long random string. Used to hash IP addresses for rate limiting so we
# never store an address. Absent = rate limiting skipped, never a weak hash.
IP_HASH_SALT=
